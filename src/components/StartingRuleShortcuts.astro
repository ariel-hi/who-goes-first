---
import type { PublicRule } from '../lib/content/schema';

interface Props { games: PublicRule[]; compact?: boolean }
const { games, compact = false } = Astro.props;
const shortcuts = [
  'catan-2020-en',
  'wingspan-online-en',
  'ticket-to-ride-2015-en',
  'uno-10020-sn70-en',
  'azul-2018-en',
  'carcassonne-2021-en',
  'root-leder-standard-en',
  'star-wars-rebellion-ffg-en',
  'rummy-bicycle-en',
  'chess-fide-laws-2023-en',
].flatMap(slug => {
  const rule = games.find(game => game.slug === slug);
  return rule ? [rule] : [];
});
const headingId = compact ? 'starting-rule-shortcuts-compact-heading' : 'starting-rule-shortcuts-heading';
---
{shortcuts.length > 0 && <section class:list={['starting-rule-shortcuts', { compact }]} aria-labelledby={headingId}>
  <h2 id={headingId}>{compact ? 'Starting rules to look up' : 'Quick starting-rule answers'}</h2>
  <p class="shortcuts-intro">Choose the reviewed edition that matches your game. Open its rule details for setup notes and the publisher source.</p>
  <ul class="shortcuts-grid">
    {shortcuts.map(rule => <li class="shortcut">
      {compact ? <a class="shortcut-compact-link" href={`/games/${rule.slug}/`}><strong>{rule.gameName}</strong><span class="shortcut-edition">{rule.editionLabel}</span></a> : <>
        <h3><a href={`/games/${rule.slug}/`}>{rule.gameName}</a></h3>
        <p class="shortcut-edition">{rule.editionLabel}</p>
        <p class="shortcut-answer">{rule.firstPlayerRule}</p>
        <a class="shortcut-source" href={`/games/${rule.slug}/`}>Rule details &amp; source<span class="sr-only"> for {rule.gameName}</span><span aria-hidden="true"> →</span></a>
      </>}
    </li>)}
  </ul>
</section>}
<style>
  .starting-rule-shortcuts { margin:30px 0 36px; }
  .starting-rule-shortcuts h2 { margin:0 0 8px; }
  .shortcuts-intro { margin:0 0 18px; color:var(--muted); font-size:14px; line-height:1.55; }
  .shortcuts-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:14px; list-style:none; padding:0; margin:0; }
  .shortcut { display:flex; flex-direction:column; min-width:0; padding:16px 18px; border:1px solid var(--line); border-radius:15px; background:var(--paper); }
  .shortcut h3 { margin:0; font-size:20px; line-height:1.3; }
  .shortcut h3 a { display:flex; align-items:center; min-height:44px; color:var(--ink); text-decoration:none; }
  .shortcut h3 a:hover, .shortcut h3 a:focus-visible { color:var(--green); text-decoration:underline; }
  .shortcut-edition { display:block; margin:0; color:var(--muted); font-size:12px; line-height:1.5; }
  .shortcut-answer { margin:12px 0; font-size:14px; line-height:1.6; overflow-wrap:anywhere; }
  .shortcut-source { display:flex; align-items:center; align-self:flex-start; min-height:44px; margin-top:auto; gap:4px; font-size:13px; font-weight:700; }
  .compact .shortcuts-grid { gap:10px; }
  .compact .shortcut { padding:0; }
  .shortcut-compact-link { display:flex; flex-direction:column; justify-content:center; min-height:72px; height:100%; padding:13px 16px; color:var(--ink); text-decoration:none; border-radius:14px; }
  .shortcut-compact-link strong { font-size:15px; }
  .shortcut-compact-link .shortcut-edition { margin-top:4px; }
  .shortcut-compact-link:hover, .shortcut-compact-link:focus-visible { background:var(--soft); }
  .shortcut-compact-link:hover strong, .shortcut-compact-link:focus-visible strong { color:var(--green); text-decoration:underline; }
  @media(max-width:550px) {
    .shortcuts-grid { grid-template-columns:1fr; }
    .shortcut { padding:13px 16px; }
  }
</style>
