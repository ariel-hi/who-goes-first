---
import { Image } from 'astro:assets';
import pinterest from '../assets/brand/pinterest.svg';
import bluesky from '../assets/brand/bluesky.svg';
import x from '../assets/brand/x-black.png';
import xWhite from '../assets/brand/x-white.svg';
import facebook from '../assets/brand/facebook.png';
import instagram from '../assets/brand/instagram.png';
import whatsapp from '../assets/brand/whatsapp.svg';
import telegram from '../assets/brand/telegram.svg';
import reddit from '../assets/brand/reddit.png';
import linkedin from '../assets/brand/linkedin.png';
import threads from '../assets/brand/threads-black.svg';
import threadsWhite from '../assets/brand/threads-white.svg';
interface Props { name: 'pinterest' | 'bluesky' | 'x' | 'facebook' | 'instagram' | 'whatsapp' | 'telegram' | 'reddit' | 'linkedin' | 'threads' | 'email' }
const { name } = Astro.props;
const icons = { pinterest, bluesky, x, facebook, instagram, whatsapp, telegram, reddit, linkedin, threads };
const darkIcon = name === 'x' ? xWhite : name === 'threads' ? threadsWhite : null;
---
{name === 'email' ? <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="m3 5 9 8 9-8" /></svg> : <Image class:list={['social-icon', { 'mono-light': darkIcon }]} src={icons[name]} width={24} densities={[1, 2]} alt="" aria-hidden="true" />}
{darkIcon && <Image class="social-icon mono-dark" src={darkIcon} width={24} alt="" aria-hidden="true" />}
<style>
  .social-icon{display:block;width:24px;height:24px;object-fit:contain;flex:none}
  .mono-dark{display:none}
  :global(html[data-theme="dark"]) .mono-light{display:none}
  :global(html[data-theme="dark"]) .mono-dark{display:block}
</style>
