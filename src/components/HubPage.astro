---
import Layout from '../layouts/Layout.astro';
import RuleList from './RuleList.astro';
import type { PublicRule } from '../lib/content/schema';
import { siteSettings } from '../lib/site';
interface Props { title: string; description: string; heading: string; lede: string; crumb: string; rules: PublicRule[] }
const { title, description, heading, lede, crumb, rules } = Astro.props;
const site = siteSettings().url;
const path = Astro.url.pathname;
---
<Layout title={title} description={description} pageType="CollectionPage" modified={rules.map(rule => rule.materiallyUpdatedAt).filter(Boolean).sort().at(-1) || undefined}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` }, { '@type': 'ListItem', position: 2, name: 'Game rules', item: `${site}/games/` }, { '@type': 'ListItem', position: 3, name: crumb, item: `${site}${path}` }] }).replace(/</g, '\\u003c')} />
  <div class="content-page">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/games/">Game rules</a> / {crumb}</nav>
    <h1>{heading}</h1>
    <p class="lede">{lede}</p>
    <slot />
    <RuleList rules={rules} />
    <p class="small muted rule-section">Each answer is our reviewed summary of that edition’s publisher rulebook. Open a game for its source, tie-break and edition details. <a href="/">Or pick a starting player at random.</a></p>
  </div>
</Layout>
