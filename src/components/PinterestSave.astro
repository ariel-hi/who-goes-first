---
import { siteSettings } from '../lib/site';
import SocialIcon from './SocialIcon.astro';

interface Props { kind: 'picker' | 'rules' | 'questions'; path?: string; description?: string }
const items = {
  picker: { path: '/', image: '/pins/first-player-picker.png', description: 'Start game night with an equal-chance draw for 2–50 players. Use numbered seats or names. Free, with no account needed.' },
  rules: { path: '/games/', image: '/pins/starting-rules.png', description: 'Search publisher-checked starting-player rules by board game and edition. Each answer links to its source.' },
  questions: { path: '/house-rules/', image: '/pins/fun-questions.png', description: 'Try an original house-rule question for a playful start to game night. Break ties with the fair picker.' },
};
// A rule page pins itself with the shared rules image.
const item = { ...items[Astro.props.kind], ...(Astro.props.path ? { path: Astro.props.path } : {}), ...(Astro.props.description ? { description: Astro.props.description } : {}) };
const site = siteSettings();
const destination = new URL('https://www.pinterest.com/pin/create/button/');
destination.search = new URLSearchParams({ url: new URL(item.path, site.url).href, media: new URL(item.image, site.url).href, description: item.description }).toString();
---
{site.production && <a class="share-bubble share-pinterest" title="Save on Pinterest" aria-label="Save on Pinterest (opens in a new tab)" href={destination.href} target="_blank" rel="noopener noreferrer"><SocialIcon name="pinterest" /></a>}
