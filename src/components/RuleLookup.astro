---
interface Props { ruleCount: number }
const { ruleCount } = Astro.props;
---
<div class="rule-lookup" data-rule-lookup>
  <label class="search-box"><span>Search {ruleCount.toLocaleString('en')} games</span><input type="search" placeholder="e.g. Catan, Wingspan, Azul…" autocomplete="off" maxlength="100" /></label>
  <ul class="rule-lookup-results" data-results hidden></ul>
  <p class="small muted" data-lookup-status role="status"></p>
  <a class="inline-link" data-directory-search href="/board-games/">Browse all board games</a>
</div>
<script>
  import { createSearchRanker, prepareSearch, type PreparedSearch } from '../lib/search';
  import { directorySearchHref } from '../lib/directory-search';
  type Entry = { n: string; a: string[]; e: string; s: string };
  type IndexedEntry = { entry: Entry; search: PreparedSearch };
  document.querySelectorAll<HTMLElement>('[data-rule-lookup]').forEach(root => {
    const input = root.querySelector('input')!;
    const list = root.querySelector<HTMLUListElement>('[data-results]')!;
    const status = root.querySelector<HTMLElement>('[data-lookup-status]')!;
    const directory = root.querySelector<HTMLAnchorElement>('[data-directory-search]')!;
    let entries: Promise<IndexedEntry[]> | undefined;
    let revision = 0;
    const load = () => entries ??= fetch('/rule-index.json').then(response => { if (!response.ok) throw new Error(); return response.json() as Promise<Entry[]>; })
      .then(all => all.map(entry => ({ entry, search: prepareSearch({ gameName: entry.n, aliases: entry.a, editionLabel: entry.e }) })))
      .catch(error => { entries = undefined; throw error; });
    input.addEventListener('focus', () => { load().catch(() => {}); }, { once: true });
    input.addEventListener('input', async () => {
      const thisRevision = ++revision;
      const query = input.value;
      list.replaceChildren(); list.hidden = true;
      directory.href = directorySearchHref(query);
      directory.textContent = query.trim() ? 'Find this game in the directory' : 'Browse all board games';
      if (!query.trim()) { status.textContent = ''; return; }
      status.textContent = 'Searching checked rules…';
      let all: IndexedEntry[];
      try { all = await load(); } catch {
        if (thisRevision === revision) status.textContent = 'Rule search is unavailable right now. Search the full board game directory instead.';
        return;
      }
      if (thisRevision !== revision) return;
      const rank = createSearchRanker(query);
      const matches = all.map(({ entry, search }) => ({ entry, rank: rank(search) }))
        .filter(match => Number.isFinite(match.rank)).sort((a, b) => a.rank - b.rank || a.entry.n.localeCompare(b.entry.n)).slice(0, 6);
      const names = new Map<string, number>();
      for (const { entry } of matches) names.set(entry.n, (names.get(entry.n) ?? 0) + 1);
      for (const { entry } of matches) {
        const item = document.createElement('li'); const link = document.createElement('a');
        link.href = `/games/${entry.s}/`; link.textContent = entry.n;
        if ((names.get(entry.n) ?? 0) > 1) { const edition = document.createElement('small'); edition.textContent = entry.e; link.append(edition); }
        item.append(link); list.append(item);
      }
      list.hidden = matches.length === 0;
      status.textContent = matches.length ? `${matches.length} ${matches.length === 1 ? 'checked rule' : 'checked rules'} shown.` : 'No checked rule matches. Find your game in the full directory, or use the picker above.';
    });
  });
</script>
