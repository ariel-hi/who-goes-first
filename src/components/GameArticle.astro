---
import SharePage from './SharePage.astro';
import RuleAd from './RuleAd.astro';
import BuyGame from './BuyGame.astro';
import EmbedRule from './EmbedRule.astro';
import { ruleHeading } from '../lib/rule-copy';
import type { PublicRule } from '../lib/content/schema';
import { siteSettings } from '../lib/site';
import { amazonSearchUrl, gearLinks } from '../lib/affiliate';
import { citedPdfPages, isPdfSource, pdfPageHref } from '../lib/source-pages';
import { coverThumbnailPath } from '../lib/content/cover-thumbnail';
import '../styles/rule-page.css';
interface Props { rule: PublicRule; related?: PublicRule[]; similar?: PublicRule[]; similarHub?: { slug: string; about: string }; publisherHub?: { slug: string; name: string; count: number }; preview?: boolean }
const { rule, related = [], similar = [], similarHub, publisherHub, preview = false } = Astro.props;
const { contact, amazonTag } = siteSettings();
const buyLink = !preview && amazonTag ? amazonSearchUrl(rule.gameName, amazonTag) : '';
const firstSource = rule.sources[0]!;
const firstPage = firstSource.pdfPagesOneBased[0];
const sourceIsPdf = isPdfSource(firstSource.url, firstSource.pdfPagesOneBased);
const passageUrl = firstPage ? pdfPageHref(firstSource.url, firstPage) : null;
// Roll-based starts link to the dice roller for tables missing their dice.
const rollsDice = /\broll(s|ed|er|ing)?\b/i.test(`${rule.firstPlayerRule} ${rule.officialTieBreak ?? ''}`);
// Card draws for the deal link to the online deck.
const drawsCards = /\b(high|low|higher|lower|highest|lowest) card\b|\bcut (for|the deck)\b|\bdraws? (cards|for)\b/i.test(`${rule.firstPlayerRule} ${rule.officialTieBreak ?? ''}`);
const houseFallbackUsesRandomChoice = /\brandom(?:ly)?\b/i.test(rule.houseFallback ?? '');
const coverImage = rule.image?.presentation === 'cover' ? rule.image : undefined;
const insetCoverImage = coverImage && (coverImage.width / coverImage.height <= 1.45 || coverImage.width < 320) ? coverImage : undefined;
const photoImages = [...(rule.image && !insetCoverImage ? [rule.image] : []), ...(rule.additionalImages ?? [])];
const creditedImages = [...(rule.image ? [rule.image] : []), ...(rule.additionalImages ?? [])];
---
<article class="game-article">
  <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a> / <a href={preview ? '/dev/games/' : '/games/'}>Game rules</a> / {rule.gameName}</nav>
  <header class:list={['rule-hero', { 'rule-hero-with-cover': !!insetCoverImage }]}>
    <div class="rule-hero-heading">
    <span class="eyebrow rule-chip">{preview ? 'Draft rule · not approved' : sourceIsPdf ? 'From the publisher’s rulebook' : 'From the source rules'}</span>
    <h1>{ruleHeading(rule.gameName)}</h1><p class="small muted rule-edition">{rule.editionLabel}{!/\bEnglish\b/i.test(rule.editionLabel) && ' · English'}</p>
    </div>
    {insetCoverImage && <figure class="rule-hero-cover"><img src={insetCoverImage.file} alt={insetCoverImage.alt} width={insetCoverImage.width} height={insetCoverImage.height} loading="eager" decoding="async" /></figure>}
    <p class="rule-answer">{rule.firstPlayerRule}</p>
    {rule.tieBreakApplicable !== false && rule.officialTieBreak && <section class="rule-section opening-tie"><h2>Official tie-break or fallback</h2><p>{rule.officialTieBreak}</p></section>}
    <nav class="source-actions" aria-label="Rulebook source">{passageUrl && <a href={passageUrl} rel="noreferrer">View cited page (PDF page {firstPage})</a>}<a href={firstSource.url} rel="noreferrer">{sourceIsPdf ? 'Read the publisher’s rulebook' : 'Read the source rules'}</a></nav>
    {photoImages.map(image => <figure class="rule-hero-photo"><img src={image.file} alt={image.alt} width={image.width} height={image.height} loading={insetCoverImage ? 'lazy' : 'eager'} decoding="async" /></figure>)}
  </header>
  <section class="rule-section rule-card source-card"><h2>Source & edition</h2><ul class="source-list">{rule.sources.map(source => {
    const pages = citedPdfPages(source.url, source.pdfPagesOneBased);
    return <li><a class="source-document" href={source.url} rel="noreferrer">{source.title}</a><small>{source.publisher} · {source.location} · Checked {source.checkedAt}</small>{pages.length > 0 ? <nav class="source-cited-pages" aria-label={`Cited PDF pages for ${source.title}`}>{pages.map(({ page, href }) => <a href={href} rel="noreferrer">PDF page {page}</a>)}</nav> : source.pdfPagesOneBased.length > 0 && <small>Cited PDF pages: {[...new Set(source.pdfPagesOneBased)].join(', ')}</small>}</li>;
  })}</ul>{publisherHub && <a class="inline-link" href={`/publishers/${publisherHub.slug}/`}>All {publisherHub.count} {publisherHub.name} starting rules</a>}{creditedImages.map(image => <p class="small muted image-credit">Image: {image.licence?.attribution ?? `© ${image.fairUse?.rightsHolder}`} · <a href={image.source.url} rel="noreferrer">{image.source.publisher}</a>{image.licence && <> · <a href={image.licence.url} rel="noreferrer">{image.licence.name}</a></>}</p>)}</section>
  {rule.pickerSuggestionApplicable !== false && !rule.houseFallback && <p class="small muted">If your rules call for a random choice, <a class="inline-link" href="/">use the player picker</a>.</p>}
  {!preview && rollsDice && <p class="small muted">Missing the dice? <a class="inline-link" href="/dice-roller/">Roll them online</a>.</p>}
  {!preview && drawsCards && <p class="small muted">No deck handy? <a class="inline-link" href="/card-draw/">Draw a card online</a>.</p>}
  {!preview && <SharePage label="Share this rule" title={ruleHeading(rule.gameName)} pin={{ path: `/games/${rule.slug}/`, description: `${ruleHeading(rule.gameName)} ${rule.firstPlayerRule}` }} />}
  {rule.clarifications.length > 0 && <section class="rule-section rule-card"><h2>Rule details</h2>{rule.clarifications.map(text => <p>{text}</p>)}</section>}
  {rule.interpretation && <section class="rule-section rule-card"><h2>Our interpretation</h2><p>{rule.interpretation}</p></section>}
  {rule.tieBreakApplicable !== false && !rule.officialTieBreak && <section class="rule-section rule-card"><h2>If there’s a tie</h2><p>{rule.houseFallback ? 'The rulebook doesn’t say.' : <>The rulebook doesn’t say. If you need a tie-break, <a href="/">pick a player at random</a>.</>}</p></section>}
  {rule.houseFallback && <aside class="fallback"><span class="eyebrow rule-chip">Optional house rule</span><h2>Not working for your group?</h2><p>{rule.houseFallback}</p>{houseFallbackUsesRandomChoice && <a class="primary" href="/">Pick a player at random</a>}</aside>}
  {!preview && <RuleAd />}
  {buyLink && <BuyGame href={buyLink} name={rule.gameName} />}
  {buyLink && amazonTag && <section class="rule-section gear-links"><h2>Game night gear</h2><ul class="gear-grid">{gearLinks(amazonTag).map(item => <li><a href={item.href} rel="sponsored nofollow noopener" target="_blank">{item.label}<small>{item.note}</small></a></li>)}</ul></section>}
  <section class="rule-section"><h2>{related.length ? 'Related games and editions' : 'More starting rules'}</h2>{related.length > 0 && <ul class="rule-links">{related.map(game => <li><a href={`/games/${game.slug}/`}>{game.image && <img class:list={['rule-link-photo', { 'rule-link-cover': game.image.presentation === 'cover' }]} src={coverThumbnailPath(game.image)} alt="" width={game.image.presentation === 'cover' ? 104 : game.image.width} height={game.image.presentation === 'cover' ? 128 : game.image.height} loading="lazy" decoding="async" />}<span>{game.gameName}<small>{game.editionLabel}</small></span></a></li>)}</ul>}<a class="inline-link" href={preview ? '/dev/games/' : '/games/'}>Browse available game rules</a></section>
  {similar.length > 0 && similarHub && <section class="rule-section"><h2>Games with a similar starting rule</h2><ul class="similar-rules">{similar.map(game => <li><a href={`/games/${game.slug}/`}>{game.image && <img class:list={['rule-link-photo', { 'rule-link-cover': game.image.presentation === 'cover' }]} src={coverThumbnailPath(game.image)} alt="" width={game.image.presentation === 'cover' ? 104 : game.image.width} height={game.image.presentation === 'cover' ? 128 : game.image.height} loading="lazy" decoding="async" />}<span>{game.gameName}<small>{game.firstPlayerRule}</small></span></a></li>)}</ul><a class="inline-link" href={`/games/themes/${similarHub.slug}/`}>More starting rules about {similarHub.about}</a></section>}
  {!preview && <p class="small muted rule-section">Free game-night tools: <a href="/score-keeper/">score keeper</a> · <a href="/turn-timer/">turn timer</a> · <a href="/dice-roller/">dice roller</a> · <a href="/tools/">all tools</a></p>}
  {!preview && <EmbedRule rule={rule} />}
  <p class="small muted rule-section">Found a different instruction in your edition? {contact ? <a href={`mailto:${contact}?subject=${encodeURIComponent(`Rule correction: ${rule.id}`)}`}>Send a correction with the game, edition, and source.</a> : 'Check the source and edition listed above against your own rulebook.'}</p>
</article>
