---
import type { PublicRule } from '../lib/content/schema';
import { siteSettings } from '../lib/site';
import { amazonDisclosure, amazonSearchUrl } from '../lib/affiliate';
interface Props { rule: PublicRule; related?: PublicRule[]; similar?: PublicRule[]; similarHub?: { slug: string; about: string }; publisherHub?: { slug: string; name: string; count: number }; preview?: boolean }
const { rule, related = [], similar = [], similarHub, publisherHub, preview = false } = Astro.props;
const { contact, amazonTag } = siteSettings();
const buyLink = !preview && amazonTag ? amazonSearchUrl(rule.gameName, amazonTag) : '';
---
<article>
  <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a> / <a href={preview ? '/dev/games/' : '/games/'}>Game rules</a> / {rule.gameName}</nav>
  <span class="eyebrow">{preview ? 'Draft rule · not approved' : 'From the publisher’s rulebook'}</span>
  <h1>Who goes first in {rule.gameName}?</h1><p class="small muted">{rule.editionLabel}{!/\bEnglish\b/i.test(rule.editionLabel) && ' · English'}</p>
  <p class="rule-answer">{rule.firstPlayerRule}</p>
  <p class="small"><a href={rule.sources[0]!.url} rel="noreferrer">Read the publisher’s rulebook</a></p>
  {rule.clarifications.length > 0 && <section class="rule-section"><h2>Rule details</h2>{rule.clarifications.map(text => <p>{text}</p>)}</section>}
  {rule.interpretation && <section class="rule-section"><h2>Our interpretation</h2><p>{rule.interpretation}</p></section>}
  <section class="rule-section"><h2>{rule.officialTieBreak ? 'Official tie-break or fallback' : 'If there’s a tie'}</h2><p>{rule.officialTieBreak || (rule.houseFallback ? 'The rulebook doesn’t say.' : <>The rulebook doesn’t say. If you need a tie-break, <a href="/">pick a player at random</a>.</>)}</p></section>
  <section class="rule-section"><h2>Source & edition</h2><ul class="source-list">{rule.sources.map(source => <li><a href={source.url} rel="noreferrer">{source.title}</a><small>{source.publisher} · {source.location} · Checked {source.checkedAt}</small></li>)}</ul>{publisherHub && <a class="inline-link" href={`/publishers/${publisherHub.slug}/`}>All {publisherHub.count} {publisherHub.name} starting rules</a>}</section>
  {rule.houseFallback && <aside class="fallback"><span class="eyebrow">Optional house rule</span><h2>Not working for your group?</h2><p>{rule.houseFallback}</p><a class="primary" href="/">Pick a player at random</a></aside>}
  {buyLink && <aside class="buy-game" aria-label="Find this game"><a href={buyLink} rel="sponsored nofollow noopener" target="_blank">Find {rule.gameName} on Amazon</a><small>{amazonDisclosure} Links never affect which rules we publish.</small></aside>}
  <section class="rule-section"><h2>{related.length ? 'Related games and editions' : 'More starting rules'}</h2>{related.length > 0 && <ul>{related.map(game => <li><a href={`/games/${game.slug}/`}>{game.gameName} — {game.editionLabel}</a></li>)}</ul>}<a class="inline-link" href={preview ? '/dev/games/' : '/games/'}>Browse available game rules</a></section>
  {similar.length > 0 && similarHub && <section class="rule-section"><h2>Games with a similar starting rule</h2><ul class="similar-rules">{similar.map(game => <li><a href={`/games/${game.slug}/`}>{game.gameName}</a><small>{game.firstPlayerRule}</small></li>)}</ul><a class="inline-link" href={`/games/themes/${similarHub.slug}/`}>More starting rules about {similarHub.about}</a></section>}
  <p class="small muted rule-section">Found a different instruction in your edition? {contact ? <a href={`mailto:${contact}?subject=${encodeURIComponent(`Rule correction: ${rule.id}`)}`}>Send a correction with the game, edition, and source.</a> : 'Check your own rulebook’s edition. A public correction contact will be listed here when the site launches.'}</p>
</article>
