---
import PinterestSave from './PinterestSave.astro';
import BlueskyShare from './BlueskyShare.astro';
import { siteSettings } from '../lib/site';
import SocialIcon from './SocialIcon.astro';
import PageShareButton from './PageShareButton.astro';
import { randomUUID } from 'node:crypto';
import '../styles/social.css';
interface Props { kind: 'picker' | 'rules' | 'questions'; title: string; shareLabel?: string; description?: string }
const { kind, title, shareLabel, description = title } = Astro.props;
const page = new URL(Astro.url.pathname, siteSettings().url).href;
const x = new URL('https://twitter.com/intent/tweet');
x.search = new URLSearchParams({ text: title, url: page }).toString();
const facebook = new URL('https://www.facebook.com/sharer/sharer.php');
facebook.search = new URLSearchParams({ u: page }).toString();
const intent = (base: string, params: Record<string, string>) => {
  const destination = new URL(base);
  destination.search = new URLSearchParams(params).toString();
  return destination.href;
};
const whatsapp = intent('https://wa.me/', { text: title + '\n' + page });
const platforms = [
  { name: 'telegram', label: 'Telegram', href: intent('https://t.me/share/url', { url: page, text: title }) },
  { name: 'reddit', label: 'Reddit', href: intent('https://www.reddit.com/submit', { url: page, title }) },
  { name: 'linkedin', label: 'LinkedIn', href: intent('https://www.linkedin.com/sharing/share-offsite/', { url: page }) },
  { name: 'threads', label: 'Threads', href: intent('https://www.threads.com/intent/post', { text: title + '\n' + page }) },
] as const;
const email = `mailto:?subject=${encodeURIComponent(title)}&body=${encodeURIComponent(title + '\n' + page)}`;
const menuId = `share-options-${randomUUID()}`;
---
<div class="social-links sharing-actions" role="group" aria-label="Share this page">
  <div class="share-quick">
    {siteSettings().production && <>
      <PinterestSave kind={kind} path={Astro.url.pathname} description={description} />
      <a class="share-bubble" href={whatsapp} target="_blank" rel="noopener noreferrer" title="Share on WhatsApp" aria-label="Share on WhatsApp (opens in a new tab)"><SocialIcon name="whatsapp" /></a>
      <a class="share-bubble" href={facebook.href} target="_blank" rel="noopener noreferrer" title="Share on Facebook" aria-label="Share on Facebook (opens in a new tab)"><SocialIcon name="facebook" /></a>
    </>}
    <button type="button" class="share-more" data-share-more aria-expanded="false" aria-controls={menuId} aria-label="More sharing options" disabled><span class="share-more-dots" aria-hidden="true">•••</span><span>More</span></button>
  </div>
  <div class="share-platforms" id={menuId} data-share-panel role="group" aria-label="More sharing options" hidden>
  <PageShareButton label={shareLabel} />
  {siteSettings().production && <>
  <BlueskyShare title={title} />
  <a href={x.href} target="_blank" rel="noopener noreferrer" aria-label="Share on X (opens in a new tab)"><SocialIcon name="x" /><span>X</span></a>
  {platforms.map(platform => <a href={platform.href} target="_blank" rel="noopener noreferrer" aria-label={`Share on ${platform.label} (opens in a new tab)`}><SocialIcon name={platform.name} /><span>{platform.label}</span></a>)}
  <a href={email} aria-label="Share by email"><SocialIcon name="email" /><span>Email</span></a>
  <a href="https://www.instagram.com/" target="_blank" rel="noopener noreferrer" data-instagram-open aria-label="Open Instagram and copy link (opens in a new tab)"><SocialIcon name="instagram" /><span>Instagram</span></a>
  </>}
  <span class="share-status small muted" role="status" data-instagram-status></span>
  <input type="url" readonly hidden aria-label="Link to copy for Instagram" data-instagram-link />
  </div>
</div>
<script>
  import { cleanLink } from '../lib/share';
  document.querySelectorAll<HTMLElement>('.social-links').forEach(root => {
    const more = root.querySelector<HTMLButtonElement>('[data-share-more]')!;
    const panel = root.querySelector<HTMLElement>('[data-share-panel]')!;
    const close = () => { panel.hidden = true; more.setAttribute('aria-expanded', 'false'); };
    more.addEventListener('click', () => {
      panel.hidden = !panel.hidden;
      more.setAttribute('aria-expanded', String(!panel.hidden));
    });
    root.addEventListener('keydown', event => {
      if (event.key === 'Escape' && !panel.hidden) { close(); more.focus(); }
    });
    more.disabled = false;
    const link = root.querySelector<HTMLAnchorElement>('[data-instagram-open]');
    if (!link) return;
    const status = root.querySelector<HTMLElement>('[data-instagram-status]')!;
    const input = root.querySelector<HTMLInputElement>('[data-instagram-link]')!;
    input.addEventListener('focus', () => input.select());
    link.addEventListener('click', async () => {
      const url = cleanLink(window.location.href);
      try {
        await navigator.clipboard.writeText(url);
        input.hidden = true;
        status.textContent = 'Link copied. Instagram opened in a new tab.';
      } catch {
        input.value = url;
        input.hidden = false;
        status.textContent = 'Copy this link for Instagram:';
        input.focus();
      }
    });
  });
</script>
