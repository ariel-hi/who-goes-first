<button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch to dark mode" aria-pressed="false" disabled>
  <svg class="theme-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.8 13A9 9 0 0 1 11 3.2 9 9 0 1 0 20.8 13Z"/></svg>
  <svg class="theme-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
</button>
<script>
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  if (button) {
    const apply = (dark: boolean) => {
      document.documentElement.dataset.theme = dark ? 'dark' : 'light';
      document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
      document.querySelector('meta[name="theme-color"]')?.setAttribute('content', dark ? '#262129' : '#f5f0ed');
      button.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode');
      button.setAttribute('aria-pressed', String(dark));
    };
    apply(document.documentElement.dataset.theme === 'dark');
    button.disabled = false;
    button.addEventListener('click', () => {
      const dark = document.documentElement.dataset.theme !== 'dark';
      apply(dark);
      try { localStorage.setItem('wgf:theme', dark ? 'dark' : 'light'); } catch { /* Theme still works when storage is blocked. */ }
    });
    window.addEventListener('storage', event => { if (event.key === 'wgf:theme') apply(event.newValue === 'dark'); });
  }
</script>
