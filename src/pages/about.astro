import Layout from '../layouts/Layout.astro';
import { siteSettings } from '../lib/site';
const contact = siteSettings().contact;
---
<Layout pageType="AboutPage" title="About — Who Goes First?" description="A small tool for the first decision of game night, with optional reveals and carefully reviewed starting-player rules."><div class="content-page prose"><h1>About</h1><p class="lede">Pick a starting player for your next game.</p><p>Use numbered seats when nobody wants to type. Add names if you like. Choose a method and pick a player. The selection works the same way in every presentation.</p><h2>Game rules</h2><p>A game’s starting instruction can differ by edition. Every rule here was checked against the publisher’s own rulebook, and each page names its source and edition. If we couldn’t find a publisher source for a game, we don’t guess.</p><p>Official instructions, our interpretation, and optional house rules are labeled separately. We’re an independent project, not affiliated with game publishers.</p><h2>No account needed</h2><p>No account, paid odds, or sign-up to see a result. Your group stays on your device. The public site offers optional page visit analytics; see <a href="/privacy/">Privacy</a> for the choice.</p><h2>Corrections & contact</h2><p>{contact ? <a href={`mailto:${contact}`}>{contact}</a> : 'This local build does not yet have an owner contact address. A maintained contact is required before public launch.'}</p><p>If a rule needs correcting, include the game, the edition, and a link to the publisher’s instruction. Don’t include your players’ names.</p><a class="inline-link" href="/">Back to the picker</a></div></Layout>

