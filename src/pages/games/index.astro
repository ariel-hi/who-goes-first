---
import Layout from '../../layouts/Layout.astro';
import GameDirectory from '../../components/GameDirectory.astro';
import RandomRule from '../../components/RandomRule.astro';
import SocialLinks from '../../components/SocialLinks.astro';
import { getCatalog } from '../../lib/content/catalog';
const games = getCatalog();
const gameCount = new Set(games.map(game => game.gameName)).size;
const title = 'Board Game Starting-Player Rules — Who Goes First?';
---
<Layout title={title} description="Look up who goes first in a board game. Search starting-player rules by game and edition, with publisher sources and clearly labeled house rules." pageType="CollectionPage" noindex={games.length === 0}><div class="content-page"><h1>Game rules.</h1><p class="lede">Who starts, according to the rulebook.</p><p>{games.length.toLocaleString('en')} starting-player rules for {gameCount.toLocaleString('en')} games, each checked against the publisher’s rules. Can’t find yours? Try the <a href="/board-games/">full board game list</a> or the <a href="/">player picker</a>.</p>{games.length > 0 && <SocialLinks kind="rules" title={title} />}<RandomRule games={games} /><GameDirectory games={games} /></div></Layout>
