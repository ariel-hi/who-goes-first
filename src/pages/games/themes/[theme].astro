---
import HubPage from '../../../components/HubPage.astro';
import { getCatalog } from '../../../lib/content/catalog';
import { themeHubs } from '../../../lib/content/hubs';
export function getStaticPaths() {
  // A rule slugged "themes" would collide with this hub directory.
  if (getCatalog().some(rule => rule.slug === 'themes')) throw new Error('The rule slug "themes" is reserved for theme hubs.');
  return themeHubs(getCatalog()).map(hub => ({ params: { theme: hub.slug }, props: { hub } }));
}
const { hub } = Astro.props as { hub: ReturnType<typeof themeHubs>[number] };
const count = hub.rules.length;
const context: Record<string, string> = {
  'youngest-player': 'Age can decide the first turn, resolve a tie, or determine who chooses the starter. The answers below preserve those differences: open the game to check the exact instruction for your edition. If your table wants equal chances instead, use the random player picker.',
  'oldest-player': 'Some rulebooks give the oldest player the opening turn; others use age only as a fallback. Check the answer and edition below before applying an age rule to your game.',
  birthdays: 'A birthday rule may depend on the next birthday, the most recent birthday, or the date itself. Read the exact condition below rather than assuming all birthday rules choose the same person.',
  'most-recently': 'These rules turn a recent experience into a starting-player question. Ask the exact question in the answer, then open the game for any official tie-break. A rule that works for one edition may change in another.',
};
---
<HubPage
  title={`${hub.title}: ${count} Board Games — Who Goes First?`}
  description={`${count} board games whose starting-player rules mention ${hub.about}. Each answer is checked against the publisher’s rulebook for that edition.`}
  heading={`Starting rules about ${hub.about}`}
  lede={`${count} sourced board game rules that mention ${hub.about} when choosing who goes first.`}
  crumb={hub.label}
  rules={hub.rules}
>
  {context[hub.slug] && <p>{context[hub.slug]}</p>}
</HubPage>
