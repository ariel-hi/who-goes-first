---
import Layout from '../../../../layouts/Layout.astro';
import BoardGameRow from '../../../../components/BoardGameRow.astro';
import { getBrowseShelves, shelfHref, shelfLabel, BROWSE_PAGE_SIZE } from '../../../../lib/content/board-game-browse';
export function getStaticPaths() {
  const { letters, shelves } = getBrowseShelves();
  return shelves.map((shelf, index) => ({ params: { letter: shelf.letter, page: String(shelf.page) }, props: {
    shelf, letters,
    previous: index > 0 ? { letter: shelves[index - 1]!.letter, page: shelves[index - 1]!.page } : undefined,
    next: index < shelves.length - 1 ? { letter: shelves[index + 1]!.letter, page: shelves[index + 1]!.page } : undefined,
  } }));
}
const { shelf, letters, previous, next } = Astro.props;
const label = shelfLabel(shelf.letter);
const pages = letters.find(item => item.letter === shelf.letter)!.pages;
const first = (shelf.page - 1) * BROWSE_PAGE_SIZE + 1;
const last = first + shelf.games.length - 1;
---
<Layout title={`Board games ${label} · Page ${shelf.page} — Who Goes First?`} description={`Browse board games starting with ${label}, names ${first} through ${last} of ${shelf.total}. Find a sourced starting-player rule when available.`} pageType="CollectionPage">
  <div class="content-page">
    <a class="back-link" href="/board-games/">← Board game directory</a>
    <h1>{label} board games.</h1>
    <p class="lede">{first.toLocaleString('en')}–{last.toLocaleString('en')} of {shelf.total.toLocaleString('en')} names in this section.</p>
    <nav class="directory-alphabet" aria-label="Browse game names by letter">{letters.map(item => <a href={shelfHref(item.letter)} aria-label={`Browse ${shelfLabel(item.letter)} games`} aria-current={item.letter === shelf.letter ? 'page' : undefined}>{shelfLabel(item.letter)}</a>)}</nav>
    <ul class="game-list directory-shelf" data-directory-shelf>
      {shelf.games.map(game => <BoardGameRow game={game} />)}
    </ul>
    <nav class="directory-pagination" aria-label="Directory pages">
      {previous && <a href={shelfHref(previous.letter, previous.page)}>← {previous.letter === shelf.letter ? 'Previous page' : shelfLabel(previous.letter)}</a>}
      <span>Page {shelf.page} of {pages}</span>
      {next && <a href={shelfHref(next.letter, next.page)}>{next.letter === shelf.letter ? 'Next page' : shelfLabel(next.letter)} →</a>}
    </nav>
    <p class="small muted">Game names link to a sourced rule when available. Open other names for a fair-draw option and a link to the game’s identity.</p>
  </div>
</Layout>
