---
import Layout from '../../layouts/Layout.astro';
import { getBoardGames } from '../../lib/content/board-games';
import { siteSettings } from '../../lib/site';
export function getStaticPaths() { return getBoardGames().map(game => ({ params: { id: game.bggId }, props: { game } })); }
const game = Astro.props.game as ReturnType<typeof getBoardGames>[number];
const site = siteSettings().url;
---
<Layout title={`${game.name} — Board Game ${game.bggId} — Who Goes First?`} description={`${game.name} (BoardGameGeek ${game.bggId}): ${game.rules.length ? 'find the sourced starting-player edition available here.' : 'find the game in our collection and use the player picker.'}`} noindex={game.rules.length === 0}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` }, { '@type': 'ListItem', position: 2, name: 'Board games', item: `${site}/board-games/` }, { '@type': 'ListItem', position: 3, name: game.name, item: `${site}/board-games/${game.bggId}/` }] }).replace(/</g, '\\u003c')} />
  <div class="content-page">
    <a class="back-link" href="/board-games/">← All board games</a>
    <h1>{game.name}</h1>
    {game.rules.length > 0 ? <><p class="lede">Starting-player rules by edition</p><ul class="game-list">{game.rules.map(rule => <li><a href={`/games/${rule.slug}/`}><span>{rule.editionLabel}<small>Read the sourced starting-player rule</small></span></a></li>)}</ul></> : <><p class="lede">A sourced starting-player rule is not available for this game yet.</p><p>Use the fair <a href="/">player picker</a> to get started.</p></>}
    <p class="small muted">Game identity: <a href={game.discoveryUrl}>BoardGameGeek {game.bggId}</a>.</p>
  </div>
</Layout>
