---
import Layout from '../../layouts/Layout.astro';
import { getBoardGames } from '../../lib/content/board-games';
import { siteSettings } from '../../lib/site';
export function getStaticPaths() {
  const games = getBoardGames();
  return games.map(game => ({ params: { id: game.bggId }, props: { game, namesake: games.filter(other => other.name === game.name).length > 1 } }));
}
const game = Astro.props.game as ReturnType<typeof getBoardGames>[number];
const site = siteSettings().url;
// Only games with several editions need their own chooser page in search results;
// the directory links single-edition games straight to the rule.
const namesake = Astro.props.namesake as boolean;
const label = namesake ? `${game.name} (BoardGameGeek ${game.bggId})` : game.name;
---
<Layout title={game.rules.length > 1 ? `Who goes first in ${label}? Choose your edition` : game.rules.length ? `${label}: starting-player rule — Who Goes First?` : `${label} — Who Goes First?`} description={game.rules.length ? `Who goes first in ${label}? Choose your edition to see the starting-player rule from the publisher’s rulebook.` : `${label} doesn’t have a sourced starting-player rule here yet. Use the fair player picker instead.`} noindex={game.rules.length < 2}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` }, { '@type': 'ListItem', position: 2, name: 'Board games', item: `${site}/board-games/` }, { '@type': 'ListItem', position: 3, name: game.name, item: `${site}/board-games/${game.bggId}/` }] }).replace(/</g, '\\u003c')} />
  <div class="content-page">
    <a class="back-link" href="/board-games/">← All board games</a>
    <h1>{game.name}</h1>
    {game.rules.length > 0 ? <><p class="lede">{game.rules.length === 1 ? 'Starting-player rule' : 'Choose your edition'}</p><ul class="game-list">{game.rules.map(rule => <li><a href={`/games/${rule.slug}/`}><span>{rule.editionLabel}<small>See who goes first</small></span></a></li>)}</ul></> : <><p class="lede">A sourced starting-player rule is not available for this game yet.</p><p>Use the fair <a href="/">player picker</a> to get started.</p></>}
    <p class="small muted">Game identity: <a href={game.discoveryUrl}>BoardGameGeek {game.bggId}</a>.</p>
  </div>
</Layout>
