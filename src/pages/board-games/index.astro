---
import Layout from '../../layouts/Layout.astro';
import { getBoardGames } from '../../lib/content/board-games';
import { getCatalog } from '../../lib/content/catalog';
const games = getBoardGames();
const withRules = games.filter(game => game.rules.length > 0).length;
const extraRules = getCatalog().filter(rule => !games.some(game => game.rules.some(linked => linked.id === rule.id)));
---
<Layout title="Board Game Directory — Who Goes First?" description={`Browse ${games.length} board games by name and find their starting-player rules when a checked edition is available.`} pageType="CollectionPage">
  <div class="content-page">
    <h1>Board games.</h1>
    <p class="lede">Find the game you’re playing.</p>
    <p>{withRules.toLocaleString('en')} of these {games.length.toLocaleString('en')} games have their official starting-player rule here. For the rest, use the <a href="/">player picker</a>.</p>
    <div data-board-directory>
      <label class="search-box"><span>Search board games</span><input type="search" placeholder="Game name…" autocomplete="off" maxlength="100" /></label>
      <p class="count-label" data-count role="status">{games.length.toLocaleString('en')} games listed</p>
      <ul class="game-list">{games.map(game => <li data-name={game.name} data-id={game.bggId}>
        <a href={game.rules.length === 1 ? `/games/${game.rules[0]!.slug}/` : `/board-games/${game.bggId}/`}><span>{game.name}<small>{game.rules.length > 1 ? `${game.rules.length} editions` : game.rules.length ? 'Official rule' : 'No rule yet'}</small></span></a>
      </li>)}</ul>
      <p data-empty hidden>No matching game in this collection.</p>
    </div>
    {extraRules.length > 0 && <section class="rule-section"><h2>More sourced editions</h2><p>These editions have a starting-player rule and are listed separately from the collection above.</p><ul class="game-list">{extraRules.map(rule => <li><a href={`/games/${rule.slug}/`}><span>{rule.gameName}<small>{rule.editionLabel}</small></span></a></li>)}</ul></section>}
  </div>
</Layout>
<script>
  import { normalizeSearch } from '../../lib/search';
  const root = document.querySelector<HTMLElement>('[data-board-directory]')!;
  const input = root.querySelector<HTMLInputElement>('input')!;
  const rows = [...root.querySelectorAll<HTMLLIElement>('li')];
  input.addEventListener('input', () => {
    const query = normalizeSearch(input.value);
    let count = 0;
    for (const row of rows) {
      row.hidden = !normalizeSearch(row.dataset.name!).includes(query) && !row.dataset.id!.includes(query);
      if (!row.hidden) count++;
    }
    root.querySelector<HTMLElement>('[data-count]')!.textContent = `${count} ${count === 1 ? 'game' : 'games'} found`;
    root.querySelector<HTMLElement>('[data-empty]')!.hidden = count > 0;
  });
</script>
