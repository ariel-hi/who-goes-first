---
import SharePage from "../../components/SharePage.astro";
import Layout from '../../layouts/Layout.astro';
import { getBrowseShelves, shelfHref, shelfLabel } from '../../lib/content/board-game-browse';
import { getCatalog } from '../../lib/content/catalog';
import { siteSettings } from '../../lib/site';
const { games, letters } = getBrowseShelves();
const { contact } = siteSettings();
const withRules = games.filter(game => game.rules.length > 0).length;
const linkedRuleIds = new Set(games.flatMap(game => game.rules.map(rule => rule.id)));
const extraRules = getCatalog().filter(rule => !linkedRuleIds.has(rule.id));
---
<Layout title="Board Game Directory — Who Goes First?" description={`Find official starting-player rules for ${withRules} board games, or browse the wider game directory by name.`} pageType="CollectionPage">
  <div class="content-page">
    <h1>All board games.</h1>
    <p class="lede">Find the game you’re playing.</p>
    <p>{withRules.toLocaleString('en')} games with sourced starting-player rules. Browse the wider list of {games.length.toLocaleString('en')} games and editions below. If yours is still awaiting one, use the <a href="/">player picker</a>.</p>
    <SharePage title="Board Game Directory — Who Goes First?" />
    <div data-board-directory>
      <label class="search-box"><span>Search board games</span><input type="search" placeholder="Game name or BGG number…" autocomplete="off" maxlength="100" disabled /></label>
      <div class="directory-filters" data-filters role="group" aria-label="Filter search results" hidden>
        <button type="button" data-filter="all" aria-pressed="true">All matches</button>
        <button type="button" data-filter="rules" aria-pressed="false">With a rule</button>
        <button type="button" data-filter="pending" aria-pressed="false">Awaiting a rule</button>
      </div>
      <p class="count-label" data-count role="status" hidden></p>
      <ul id="directory-results" class="game-list directory-results" data-results hidden></ul>
      <button type="button" class="directory-more" data-more aria-controls="directory-results" hidden>Show more games</button>
      <div class="directory-empty" data-empty hidden>
        <h2>No matching games</h2>
        <p>Try a shorter name or another filter. You can also <a href="/">pick a starting player</a> now.</p>
        {contact && <p class="directory-request" data-request-prompt>Still missing? <a data-request-game data-contact={contact} href={`mailto:${contact}?subject=Board%20game%20request`}>Request this game</a>. Include an official publisher link and the edition if you know them.</p>}
      </div>
      <noscript><p class="small muted">Browse the letter pages below. Search needs JavaScript.</p></noscript>
    </div>
    <h2 class="directory-browse-heading">Browse by name</h2>
    <nav class="directory-letter-grid" aria-label="Browse game names by letter">
      {letters.map(({ letter, count }) => <a href={shelfHref(letter)}><strong>{shelfLabel(letter)}</strong><span>{count.toLocaleString('en')} {count === 1 ? 'game' : 'games'}</span></a>)}
    </nav>
    <p class="small muted">This collection is growing. Additional game names come from <a href="https://www.wikidata.org/wiki/Property:P2339">Wikidata</a> under CC0. Starting rules are checked against publisher sources. Open a name without a rule for a fair-draw option.</p>
    {extraRules.length > 0 && <section class="rule-section"><h2>More sourced editions</h2><p>These editions have a starting-player rule and are listed separately from the collection above.</p><ul class="game-list">{extraRules.map(rule => <li><a href={`/games/${rule.slug}/`}><span>{rule.gameName}<small>{rule.editionLabel}</small></span></a></li>)}</ul></section>}
  </div>
</Layout>
<script>
  import { directorySearchKey } from '../../lib/search';
  import { directorySearchHref, readDirectorySearchState, type DirectoryFilter } from '../../lib/directory-search';
  import { directoryEntryLinks, type DirectoryEntry } from '../../lib/directory-entry';
  type SearchGame = { name: string; nameKey: string; id: string; href?: string; reference?: { url: string; label: string }; numericId?: string; search: string; hasRule: boolean; ruleCount: number };
  const root = document.querySelector<HTMLElement>('[data-board-directory]')!;
  const input = root.querySelector<HTMLInputElement>('input')!;
  const filters = root.querySelector<HTMLElement>('[data-filters]')!;
  const count = root.querySelector<HTMLElement>('[data-count]')!;
  const results = root.querySelector<HTMLUListElement>('[data-results]')!;
  const more = root.querySelector<HTMLButtonElement>('[data-more]')!;
  const empty = root.querySelector<HTMLElement>('[data-empty]')!;
  const requestPrompt = root.querySelector<HTMLElement>('[data-request-prompt]');
  const requestGame = root.querySelector<HTMLAnchorElement>('[data-request-game]');
  const batchSize = 80;
  let data: SearchGame[] | undefined;
  let loading: Promise<SearchGame[]> | undefined;
  let matchedGames: SearchGame[] = [];
  let shown = 0;
  let filter: DirectoryFilter = 'all';
  let revision = 0;
  let renderedState: { query: string; filter: DirectoryFilter } | undefined;
  let showNext: (() => HTMLLIElement | undefined) | undefined;
  const compact = directorySearchKey;
  const load = () => loading ??= fetch('/board-games/search.json').then(response => {
    if (!response.ok) throw new Error(`Search unavailable (${response.status})`);
    return response.json() as Promise<DirectoryEntry[]>;
  }).then(entries => data = entries.map(game => ({
    name: game.name, nameKey: compact(game.name), id: game.id, ruleCount: game.ruleCount,
    hasRule: game.ruleCount > 0,
    ...directoryEntryLinks(game),
    search: compact([game.name, ...(game.terms ?? [])].join(' ')),
  }))).catch(error => { loading = undefined; throw error; });
  const render = async () => {
    const thisRevision = ++revision;
    const rawQuery = input.value;
    if (requestGame) {
      const game = rawQuery.trim();
      requestGame.href = `mailto:${requestGame.dataset.contact}?subject=${encodeURIComponent(`Board game request: ${game}`)}&body=${encodeURIComponent(`Game: ${game}\nOfficial publisher link:\nEdition (if known):\n`)}`;
    }
    const renderedFilter = filter;
    const query = compact(rawQuery);
    renderedState = undefined;
    matchedGames = []; shown = 0; showNext = undefined; more.hidden = true;
    results.replaceChildren();
    results.hidden = true; filters.hidden = true; empty.hidden = true;
    if (!query) {
      results.hidden = true; filters.hidden = true; count.hidden = true; empty.hidden = true;
      renderedState = { query: rawQuery, filter: renderedFilter };
      return;
    }
    count.hidden = false; count.textContent = 'Searching…';
    try { await load(); } catch {
      if (thisRevision === revision) count.textContent = 'Search is unavailable. Browse by letter below.';
      return;
    }
    if (thisRevision !== revision) return;
    matchedGames = data!.filter(game => (game.search.includes(query) || game.numericId?.includes(query)) && (filter === 'all' || game.hasRule === (filter === 'rules')));
    if (requestPrompt) requestPrompt.hidden = filter !== 'all';
    matchedGames.sort((a, b) => {
      const rank = (game: SearchGame) => game.numericId === query || game.nameKey === query ? 0 : game.nameKey.startsWith(query) ? 1 : 2;
      return rank(a) - rank(b) || a.name.localeCompare(b.name, 'en', { numeric: true });
    });
    showNext = () => {
      const next = matchedGames.slice(shown, shown + batchSize);
      const fragment = document.createDocumentFragment();
      let first: HTMLLIElement | undefined;
      for (const game of next) {
        const item = document.createElement('li');
        first ??= item;
        item.dataset.id = game.id;
        item.dataset.hasRule = String(game.hasRule);
        const label = document.createElement('span'); label.textContent = game.name;
        const status = document.createElement('small'); status.textContent = game.ruleCount > 1 ? `${game.ruleCount} sourced editions` : game.hasRule ? 'Starting rule available' : 'No checked starting rule yet';
        label.append(status);
        if (game.hasRule) {
          const link = document.createElement('a'); link.href = game.href!; link.append(label);
          const arrow = document.createElement('span'); arrow.className = 'directory-arrow'; arrow.ariaHidden = 'true'; arrow.textContent = '→'; link.append(arrow);
          item.append(link);
        } else {
          const details = document.createElement('details'); details.className = 'directory-pending';
          const summary = document.createElement('summary'); summary.append(label);
          const disclosure = document.createElement('span'); disclosure.className = 'directory-disclosure'; disclosure.ariaHidden = 'true'; summary.append(disclosure);
          const help = document.createElement('div'); help.className = 'directory-pending-help';
          const explanation = document.createElement('p'); explanation.textContent = 'We haven’t checked this game’s starting rule yet. Follow the rulebook in your box, or give every player an equal chance with the picker.';
          const actions = document.createElement('div'); actions.className = 'directory-pending-actions';
          const picker = document.createElement('a'); picker.className = 'directory-picker-link'; picker.href = '/'; picker.textContent = 'Pick a player';
          actions.append(picker);
          if (game.reference) {
            const identity = document.createElement('a'); identity.href = game.reference.url;
            identity.textContent = game.reference.label === 'BoardGameGeek' ? 'View game on BoardGameGeek ↗' : `${game.reference.label} ↗`;
            actions.append(identity);
          }
          help.append(explanation, actions); details.append(summary, help); item.append(details);
        }
        fragment.append(item);
      }
      results.append(fragment);
      shown += next.length;
      more.hidden = shown >= matchedGames.length;
      if (!more.hidden) more.textContent = `Show next ${Math.min(batchSize, matchedGames.length - shown)} games`;
      count.textContent = `${matchedGames.length.toLocaleString('en')} ${matchedGames.length === 1 ? 'game' : 'games'} found${more.hidden ? '' : ` · showing ${shown.toLocaleString('en')}`}`;
      return first;
    };
    showNext();
    results.hidden = matchedGames.length === 0;
    filters.hidden = false;
    empty.hidden = matchedGames.length !== 0;
    renderedState = { query: rawQuery, filter: renderedFilter };
  };
  more.addEventListener('click', () => {
    const first = showNext?.();
    first?.querySelector<HTMLElement>('a, summary')?.focus();
  });
  const showFilter = () => {
    for (const choice of filters.querySelectorAll<HTMLButtonElement>('button')) choice.setAttribute('aria-pressed', String(choice.dataset.filter === filter));
  };
  const saveSearch = () => {
    const href = directorySearchHref(input.value, filter);
    const hash = href.slice('/board-games/'.length);
    if (hash === location.hash) return;
    // Keep one directory visit in Back history. Fragments stay out of HTTP
    // requests and canonical URLs; preserve any unrelated history state.
    try { history.replaceState(history.state, '', location.pathname + location.search + hash); }
    catch { /* Search still works when the browser blocks history writes. */ }
  };
  input.disabled = false;
  input.addEventListener('input', () => {
    if (!input.value.trim()) { filter = 'all'; showFilter(); }
    saveSearch();
    void render();
  });
  filters.addEventListener('click', event => {
    const button = (event.target as Element).closest<HTMLButtonElement>('button[data-filter]');
    if (!button) return;
    filter = button.dataset.filter as DirectoryFilter;
    showFilter();
    saveSearch();
    void render();
  });
  const restoreFragmentSearch = (preserveRendered = false) => {
    if (location.hash && !location.hash.startsWith('#q=')) return;
    const { query, filter: restoredFilter, invalid } = readDirectorySearchState(location.hash);
    // Preserve focus and open disclosures only for a valid completed cached UI.
    if (preserveRendered && !invalid && input.value === query && filter === restoredFilter
      && renderedState?.query === query && renderedState.filter === restoredFilter) return;
    input.value = query;
    filter = restoredFilter;
    showFilter();
    void render();
    if (invalid) {
      renderedState = undefined;
      count.hidden = false;
      count.textContent = 'This search link could not be read. Search by name or browse by letter below.';
    }
  };
  restoreFragmentSearch();
  window.addEventListener('hashchange', () => restoreFragmentSearch());
  window.addEventListener('pageshow', event => { if (event.persisted) restoreFragmentSearch(true); });
</script>
