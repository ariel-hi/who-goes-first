---
import Layout from '../layouts/Layout.astro';
import PickerShell from '../components/PickerShell.astro';
import RuleLookup from '../components/RuleLookup.astro';
import HomeRandomRule from '../components/HomeRandomRule.astro';
import { getCatalog } from '../lib/content/catalog';
import { siteSettings } from '../lib/site';
const localPreview = import.meta.env.DEV && !siteSettings().production;
const balloonEnabled = process.env.DISABLE_BALLOON !== 'true';
const approved = getCatalog();
const gameCount = new Set(approved.map(rule => rule.gameName)).size;
const gamesPath = localPreview ? '/dev/games/' : '/games/';
---
<Layout ads={false} title="Who Goes First? Random First Player Picker" description="Choose who goes first in your board game. A free, fair random picker for 2–50 players, with names or numbered seats. No account or download needed.">
  <div class="tool-page home-page">
    <noscript><p class="noscript">Enable JavaScript to pick a player on your device. You can still browse the static rules and fairness pages.</p></noscript>
    <div class="home-layout">
      <section class="home-picker" aria-labelledby="home-picker-heading">
        <div class="home-picker-heading"><h1 id="home-picker-heading">Pick a player</h1></div>
        <PickerShell balloonEnabled={balloonEnabled} />
      </section>
      <section class="home-rules" aria-labelledby="home-rules-heading">
        <h2 id="home-rules-heading">Playing a specific game?</h2>
        <p>Many rulebooks say who starts. Look it up, straight from the publisher’s rules.</p>
        {approved.length > 0 && <RuleLookup ruleCount={gameCount} />}
        <HomeRandomRule games={approved} />
        <ul class="home-rules-links">
          <li><a href={gamesPath}>Browse game rules</a></li>
          <li class="mobile-random-link"><a href={`${gamesPath}#random-rule`}>Try a random rule</a></li>
          <li><a href="/house-rules/">Fun questions</a></li>
          <li><a href="/choose-who-goes-first/">How to choose who starts</a></li>
        </ul>
      </section>
    </div>
  </div>
</Layout>
