---
import Layout from '../layouts/Layout.astro';
import PickerShell from '../components/PickerShell.astro';
import RandomRule from '../components/RandomRule.astro';
import { getCatalog, readRecords } from '../lib/content/catalog';
import { publicRule, ruleSchema } from '../lib/content/schema';
import { siteSettings } from '../lib/site';
const localPreview = import.meta.env.DEV && !siteSettings().production;
const balloonEnabled = process.env.DISABLE_BALLOON !== 'true';
const approved = getCatalog();
const drafts = localPreview ? readRecords('research/games').map(record => publicRule(ruleSchema.parse(record))) : [];
const games = [...approved, ...drafts].filter((game, index, all) => all.findIndex(other => other.id === game.id) === index);
const gamesPath = localPreview ? '/dev/games/' : '/games/';
---
<Layout ads={false} title="Who Goes First? Random First Player Picker" description="Choose who goes first in your board game. A free, fair random picker for 2–50 players, with names or numbered seats. No account or download needed.">
  <div class="tool-page home-page">
    <noscript><p class="noscript">Enable JavaScript to pick a player on your device. You can still browse the static rules and fairness pages.</p></noscript>
    <div class="home-layout">
      <section class="home-picker" aria-labelledby="home-picker-heading">
        <div class="home-picker-heading"><h1 id="home-picker-heading">Pick a player</h1></div>
        <PickerShell balloonEnabled={balloonEnabled} />
        {games.length > 0 && <details class="home-rule-picker">
          <summary>Use a board game rule</summary>
          <RandomRule games={games} prefix={localPreview ? '/dev/rules/' : '/games/'} approvedIds={approved.map(game => game.id)} featured />
        </details>}
      </section>
      <section class="home-rules" aria-labelledby="home-rules-heading">
        <h2 id="home-rules-heading">Board game rules</h2>
        <p>Look up who starts in the game you're playing.</p>
        <a class="home-rules-browse" href={gamesPath}>Browse game rules</a>
        <p class="home-rules-pending"><a href="/board-games/">Browse all board games</a></p>
        <p class="home-rules-pending"><a href="/house-rules/">Or try a fun question</a></p>
      </section>
    </div>
  </div>
</Layout>
