---
import Layout from '../layouts/Layout.astro';
import HousePrompts from '../components/HousePrompts.astro';
import { getPrompts } from '../lib/content/catalog';
const prompts = getPrompts();
---
<Layout title="Original house rules — Who Goes First?" description="Let your table choose a playful starting criterion. Original house-rule questions are separate from equal-chance player selection." noindex={!prompts.length}><div class="content-page"><h1>House rules</h1><p class="lede">House rule: your group decides who qualifies.</p><p>Randomly choosing a question does <strong>not</strong> give people equal chances. These are original conversation prompts, never official rules of a game. Skip freely, or agree to a random tie-break.</p>{prompts.length ? <HousePrompts prompts={prompts} /> : <div class="empty-state"><h2>No questions published yet</h2><p>No house-rule prompts have been approved for publication yet.</p><a class="inline-link" href="/">Give every player an equal chance</a></div>}</div></Layout>
