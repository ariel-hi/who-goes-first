---
import Layout from '../../layouts/Layout.astro';
import PickerShell from '../../components/PickerShell.astro';
const enabled = process.env.DISABLE_BALLOON !== 'true';
---
<Layout title={enabled ? 'Balloon Rise: Random Player Picker — Who Goes First?' : 'Balloon Rise unavailable — Who Goes First?'} description={enabled ? 'Choose a starting player with Balloon Rise. Each player gets a balloon and an equal chance. The last balloon floating reveals who goes first.' : 'Balloon Rise is currently unavailable. You can still pick a starting player with Quick, Instant or another reveal.'} noindex={!enabled}>
  <div class="tool-page">
    <div class="intro"><h1>Who goes first?</h1>{!enabled && <p>Balloon Rise is unavailable. You can still pick a player.</p>}</div>
    <noscript><p class="noscript">Enable JavaScript to pick a player.</p></noscript>
    <PickerShell initialMode={enabled ? 'balloon' : 'quick'} balloonEnabled={enabled} />
    <div class="below-tool">
      {enabled && <><h2>How Balloon Rise works</h2><p>Each player gets a balloon. The last balloon goes first. Popped balloons stay on the table until you pick again or edit the players. For more than 12 players, the picker uses Instant.</p><p>Use “Show result now” to skip the reveal. If you prefer reduced motion, the result appears immediately.</p></>}
      <a class="inline-link" href="/fairness/">How the fair draw works</a><br /><a class="inline-link" href="/">Back to the starting-player picker</a>
    </div>
  </div>
</Layout>
