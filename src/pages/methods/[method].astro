---
import Layout from '../../layouts/Layout.astro';
import PickerShell from '../../components/PickerShell.astro';
import type { Mode } from '../../lib/preferences';
export function getStaticPaths() {
  return [
    { params: { method: 'spinner' }, props: { mode: 'spinner', name: 'Spinner', description: 'Spin an equal-slice wheel to choose your starting player. Add names or numbered seats, then let the wheel reveal the fair draw.', detail: 'Every player has an equally sized slice. The marker lands at a varied point inside the chosen slice. The browser selects the result first, so the wheel’s speed and screen size do not affect anyone’s chances.' } },
    { params: { method: 'cards' }, props: { mode: 'cards', name: 'Card Draw', description: 'Deal a card to each player. The card marked GO goes first. Everyone has an equal chance.', detail: 'Each player gets a card. The card marked GO shows who goes first. The cards stay face up until you pick again or edit the players.' } },
    { params: { method: 'towers' }, props: { mode: 'tower', name: 'Towers', description: 'Build a tower for each player. The last tower standing goes first.', detail: 'All towers build the same way. Then all but one collapse. The standing tower goes first, and the fallen blocks stay on the table.' } },
    { params: { method: 'straws' }, props: { mode: 'straws', name: 'Shortest Match', description: 'Draw matches to choose a first player. The shortest match goes first.', detail: 'Each player gets a match with a colored head. The covers slide away to reveal the lengths. The shortest match goes first.' } },
    { params: { method: 'dice' }, props: { mode: 'dice', name: 'Dice Roll', description: 'Choose a first player with a pair of dice for each person. Highest total goes first.', detail: 'Each player gets two dice. The highest total goes first. The dice show a winner selected by the same equal-chance draw as the other methods, so there are no ties to reroll.' } },
    { params: { method: 'coin' }, props: { mode: 'coin', name: 'Coin Flip', description: 'Flip a coin for every player and reveal one crowned face. Everyone has an equal chance to go first.', detail: 'Every player gets a coin. The coins flip together; one lands with a crown face up. That player goes first. The result is chosen fairly before the animation begins.' } },
    { params: { method: 'shells' }, props: { mode: 'shells', name: 'Shell Game', description: 'Lift a shell for each player. Whoever finds the pearl goes first.', detail: 'Each shell wiggles and lifts. One reveals a pearl. That player goes first, and the shells stay open until you pick again or edit the players.' } },
  ];
}
const { mode, name, description, detail } = Astro.props as { mode: Mode; name: string; description: string; detail: string };
---
<Layout ads={false} title={`${name}: First Player Picker — Who Goes First?`} description={description}>
  <div class="tool-page"><div class="intro"><h1>Who goes first?</h1></div><noscript><p class="noscript">Enable JavaScript to pick a player.</p></noscript><PickerShell initialMode={mode} /><div class="below-tool"><h2>How {name} works</h2><p>{detail}</p><p>Most reveals fit 2–12 players; Dice and Coin fit up to 24. Quick and Instant fit larger groups. Reduced motion shows the result immediately.</p><a class="inline-link" href="/fairness/">How the draw works</a><br/><a class="inline-link" href="/">Back to the picker</a></div></div>
</Layout>
